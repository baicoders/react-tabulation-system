# Copy to .env and change every value before event day.

# PostgreSQL
POSTGRES_USER=tabulation
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tabulation

# API
# Inside Docker the host is "db". For local dev outside Docker use localhost.
DATABASE_URL=postgresql://tabulation:change-me@localhost:5432/tabulation
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
API_PORT=3000

# First admin account, created by the seed script if it does not exist
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Port the web UI is published on, on the server PC
WEB_PORT=80
